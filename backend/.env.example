# App
APP_NAME="Andromeda Logic Corp API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176

# MySQL — Section 11.2 Backend/CMS
# mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://alc_user:changeme@localhost:3306/andromeda_logic_corp

# NOVA AI Assistant — Section 10.5/10.6
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Export-control gating (Section 9.14, 14.1) — placeholder toggle, wire to
# real identity/org verification before production launch.
EXPORT_CONTROL_GATING_ENABLED=true


# Admin CMS auth — Section 12.1 (JWT bearer tokens issued by POST /auth/login)
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25